{
  "name": "xonava-workspace",
  "description": "Monorepo for Xonava, an experimental TypeScript server framework: @xonava/core, @xonava/adapters and @xonava/testing.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonava/xonava.git"
  },
  "homepage": "https://github.com/xonava/xonava#readme",
  "bugs": {
    "url": "https://github.com/xonava/xonava/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/adapters",
    "packages/testing"
  ],
  "scripts": {
    "clean": "node scripts/verification/cleanGeneratedOutputs.mjs",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build": "npm run clean && npm run build:workspaces && npm run verify:generated-surface",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:mutation": "npm run test:mutation -w @xonava/core -w @xonava/adapters",
    "lint": "npm run lint --workspaces --if-present",
    "verify:version": "node --experimental-strip-types scripts/verification/verifyFrameworkVersionPolicy.ts",
    "verify:docs": "node scripts/verification/verifyDocumentation.mjs",
    "verify:generated-surface": "node scripts/verification/verifyGeneratedSurface.mjs",
    "verify:architecture": "node scripts/verification/verifyArchitecture.mjs",
    "verify:ownership": "node scripts/verification/verifyCanonicalSourceOwnership.mjs",
    "verify:fixtures": "node scripts/verification/verifyFrameworkFixtures.mjs",
    "verify:isolation": "node scripts/verification/verifyFrameworkIsolation.mjs",
    "verify:core-purity": "node scripts/verification/verifyFrameworkCorePurity.mjs",
    "verify:hardening": "node scripts/verification/verifyFrameworkHardening.mjs",
    "verify": "npm run verify:version && npm run verify:docs && npm run verify:generated-surface && npm run verify:architecture && npm run verify:ownership && npm run verify:fixtures && npm run verify:core-purity && npm run verify:hardening",
    "verify:differentials": "node scripts/verification/differentials.mjs",
    "verify:release": "node scripts/verification/runReleaseCheck.mjs",
    "test:integration:pg": "npm run test:integration:pg -w @xonava/testing",
    "test:integration:d1": "npm run test:integration:d1 -w @xonava/testing",
    "test:integration:mysql": "npm run test:integration:mysql -w @xonava/testing",
    "test:conformance:pg": "npm run test:conformance:pg -w @xonava/testing",
    "test:conformance:d1": "npm run test:conformance:d1 -w @xonava/testing",
    "test:conformance:mysql": "npm run test:conformance:mysql -w @xonava/testing",
    "test:race:pg": "npm run test:race:pg -w @xonava/testing",
    "test:race:d1": "npm run test:race:d1 -w @xonava/testing",
    "test:race:mysql": "npm run test:race:mysql -w @xonava/testing",
    "test:crash:pg": "npm run test:crash:pg -w @xonava/testing",
    "test:crash:d1": "npm run test:crash:d1 -w @xonava/testing",
    "test:crash:mysql": "npm run test:crash:mysql -w @xonava/testing",
    "soak": "npm run soak -w @xonava/testing",
    "bench": "node scripts/verification/verifyBenchmarks.mjs",
    "bench:update-baseline": "node scripts/verification/verifyBenchmarks.mjs --update-baseline",
    "test:verification": "node --test scripts/verification/differentialSupport.test.mjs scripts/verification/frameworkVersionPolicy.test.mjs scripts/verification/benchmarkComparison.test.mjs",
    "changeset": "changeset",
    "release:version": "node scripts/release/versionPackages.mjs",
    "release:publish": "npm run verify:version && npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
