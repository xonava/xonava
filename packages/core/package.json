{
  "name": "@xonava/core",
  "version": "2.0.0-rc.2",
  "description": "Zero-dependency core of the server framework: runtime-neutral semantics and contracts for entities, operations, persistence, events, workflows, and access policy.",
  "keywords": [
    "server",
    "framework",
    "domain",
    "entity",
    "persistence",
    "events",
    "workflow",
    "abac",
    "contracts",
    "zero-dependency"
  ],
  "homepage": "https://github.com/xonava/xonava#readme",
  "bugs": {
    "url": "https://github.com/xonava/xonava/issues"
  },
  "license": "MIT",
  "author": "Suriyaprakash Somu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonava/xonava.git",
    "directory": "packages/core"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && node ../../scripts/verification/rewriteBuildExtensions.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aggregate": {
