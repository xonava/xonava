{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@xonava/core": ["../core/dist/index.d.ts"],
      "@xonava/core/*": ["../core/dist/*"],
      "@xonava/adapters": ["../adapters/dist/index.d.ts"],
      "@xonava/adapters/*": ["../adapters/dist/*"]
    }
  },
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../adapters/tsconfig.build.json" }
  ],
  "include": ["src"]
}
