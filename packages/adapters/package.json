{
  "name": "@xonava/adapters",
  "version": "0.2.0",
  "description": "Adapters for the server framework: PostgreSQL, MySQL, and Cloudflare D1 persistence via Drizzle, Express, Fastify, and Hono HTTP bindings, and cache and storage adapters.",
  "keywords": [
    "server",
    "framework",
    "adapters",
    "postgresql",
    "mysql",
    "cloudflare-d1",
    "drizzle",
    "express",
    "fastify",
    "hono",
    "cache",
    "storage"
  ],
  "homepage": "https://github.com/xonava/xonava#readme",
  "bugs": {
    "url": "https://github.com/xonava/xonava/issues"
  },
  "license": "MIT",
  "author": "Suriyaprakash Somu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonava/xonava.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && node ../../scripts/verification/rewriteBuildExtensions.mjs ../core .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "test:mutation": "stryker run",
    "prepack": "npm run build"
  },
  "exports": {
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./drizzle-d1": {
      "types": "./dist/drizzle-d1/index.d.ts",
      "default": "./dist/drizzle-d1/index.js"
    },
    "./drizzle-pg": {
      "types": "./dist/drizzle-pg/index.d.ts",
      "default": "./dist/drizzle-pg/index.js"
    },
    "./drizzle-mysql": {
      "types": "./dist/drizzle-mysql/index.d.ts",
      "default": "./dist/drizzle-mysql/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    }
  },
  "peerDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0",
    "mysql2": "^3.24.4",
    "pg": "^8.16.3"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "@types/pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "@xonava/core": "0.2.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "hono": "^4.13.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
