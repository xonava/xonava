{
  "name": "xonava-workspace",
  "description": "Monorepo for Xonava, an experimental TypeScript server framework: @xonava/core, @xonava/adapters and @xonava/testing.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonava/xonava.git"
  },
  "homepage": "https://github.com/xonava/xonava#readme",
  "bugs": {
    "url": "https://github.com/xonava/xonava/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/adapters",
    "packages/testing"
  ],
  "scripts": {
    "clean": "node scripts/verification/cleanGeneratedOutputs.mjs",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build": "npm run clean && npm run build:workspaces && npm run verify:generated-surface",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify:framework:fixtures": "node scripts/verification/verifyFrameworkFixtures.mjs",
    "verify:framework:isolation": "node scripts/verification/verifyFrameworkIsolation.mjs",
    "verify:framework:core-purity": "node scripts/verification/verifyFrameworkCorePurity.mjs",
    "verify:framework:hardening": "node scripts/verification/verifyFrameworkHardening.mjs",
    "verify:fresh-core": "node scripts/verification/verifyFreshCoreArchitecture.mjs",
    "verify:canonical-source-ownership": "node scripts/verification/verifyCanonicalSourceOwnership.mjs",
    "verify:repository-inventory": "node scripts/verification/auditRepositoryFiles.mjs",
    "verify:docs": "node scripts/verification/verifyDocumentation.mjs",
    "verify:generated-surface": "node scripts/verification/verifyGeneratedSurface.mjs",
    "test:framework:integration:pg": "npm run test:integration:pg -w @xonava/testing",
    "test:framework:integration:d1": "npm run test:integration:d1 -w @xonava/testing",
    "test:framework:integration:mysql": "npm run test:integration:mysql -w @xonava/testing",
    "test:framework:conformance:pg": "npm run test:conformance:pg -w @xonava/testing",
    "test:framework:conformance:d1": "npm run test:conformance:d1 -w @xonava/testing",
    "test:framework:conformance:mysql": "npm run test:conformance:mysql -w @xonava/testing",
    "test:framework:race:pg": "npm run test:race:pg -w @xonava/testing",
    "test:framework:race:d1": "npm run test:race:d1 -w @xonava/testing",
    "test:framework:race:mysql": "npm run test:race:mysql -w @xonava/testing",
    "test:framework:crash:pg": "npm run test:crash:pg -w @xonava/testing",
    "test:framework:crash:d1": "npm run test:crash:d1 -w @xonava/testing",
    "test:framework:crash:mysql": "npm run test:crash:mysql -w @xonava/testing",
    "verify:framework:q1-q2": "node scripts/verification/verifyQ1Q2Certification.mjs",
    "verify:framework:e1": "node scripts/verification/verifyE1Certification.mjs",
    "verify:framework:d1": "node scripts/verification/verifyD1Certification.mjs",
    "verify:framework:tx1": "node scripts/verification/verifyTX1Certification.mjs",
    "verify:framework:op1": "node scripts/verification/verifyOP1Certification.mjs",
    "verify:framework:s1": "node scripts/verification/verifyS1Certification.mjs",
    "verify:framework:c1": "node scripts/verification/verifyC1Certification.mjs",
    "verify:framework:ev1": "node scripts/verification/verifyEV1Certification.mjs",
    "verify:framework:l1": "node scripts/verification/verifyL1Certification.mjs",
    "verify:framework:j1": "node scripts/verification/verifyJ1Certification.mjs",
    "verify:framework:w1": "node scripts/verification/verifyW1Certification.mjs",
    "verify:framework:o1": "node scripts/verification/verifyO1Certification.mjs",
    "verify:framework:r1": "node scripts/verification/verifyR1Certification.mjs",
    "verify:framework:t1": "node scripts/verification/verifyT1Certification.mjs",
    "verify:framework:er1": "node scripts/verification/verifyER1Certification.mjs",
    "verify:framework:g1": "node scripts/verification/verifyG1Certification.mjs",
    "verify:framework:h1": "node scripts/verification/verifyH1Certification.mjs",
    "verify:framework:rl1": "node scripts/verification/verifyRL1Certification.mjs",
    "verify:framework:ag1": "node scripts/verification/verifyAG1Certification.mjs",
    "verify:framework:th1": "node scripts/verification/verifyTH1Certification.mjs",
    "verify:framework:n1": "node scripts/verification/verifyN1Certification.mjs",
    "verify:framework:ht1": "node scripts/verification/verifyHT1Certification.mjs",
    "verify:framework:b1": "node scripts/verification/verifyB1Certification.mjs",
    "verify:framework:f1": "node scripts/verification/verifyF1Certification.mjs",
    "verify:framework:df1": "node scripts/verification/verifyDF1Certification.mjs",
    "bench": "node scripts/verification/verifyBenchmarks.mjs",
    "bench:update-baseline": "node scripts/verification/verifyBenchmarks.mjs --update-baseline",
    "test:verification": "node --test scripts/verification/differentialCertification.test.mjs scripts/verification/frameworkVersionPolicy.test.mjs scripts/verification/benchmarkComparison.test.mjs",
    "verify:framework:api": "node scripts/verification/verifyApiCertification.mjs",
    "verify:framework:cert": "node scripts/verification/verifyFinalCertification.mjs",
    "verify:framework:mysql1": "node scripts/verification/verifyMYSQL1Certification.mjs",
    "verify:framework-version": "node --experimental-strip-types scripts/verification/verifyFrameworkVersionPolicy.ts",
    "verify:framework-release:local": "npm run verify:framework-version && npm run verify:docs && npm run verify:framework:fixtures && npm run verify:framework:isolation && npm run lint && npm run build && npm run verify:framework:core-purity && npm run verify:framework:hardening && npm run verify:framework:rl1 && npm run verify:framework:ag1 && npm run verify:framework:th1 && npm run verify:framework:n1 && npm run verify:framework:ht1 && npm run test && npm run test:coverage -w @xonava/core && npm run test:framework:integration:d1 && npm run test:framework:conformance:d1 && npm run test:framework:race:d1 && npm run test:framework:crash:d1",
    "verify:framework-release:baseline": "npm run verify:framework-release:local && npm run test:framework:integration:pg && npm run test:framework:conformance:pg && npm run test:framework:race:pg && npm run test:framework:crash:pg && npm run test:framework:integration:mysql && npm run test:framework:conformance:mysql && npm run test:framework:race:mysql && npm run test:framework:crash:mysql",
    "verify:framework-release": "node scripts/verification/runFrameworkReleaseCertification.mjs",
    "changeset": "changeset",
    "release:version": "node scripts/release/versionPackages.mjs",
    "release:publish": "npm run verify:framework-version && npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "esbuild": "0.28.2",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
